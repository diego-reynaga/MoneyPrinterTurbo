# Imagen variante para Claude Code: instala la CLI claude sobre la imagen oficial publicada.
#
# La suscripción de Claude (Pro / Max / Team) no emite claves API, y solo el cliente oficial de Claude Code
# puede usar sus credenciales, así que el proveedor `claude_code` necesita que haya una CLI claude
# ejecutable dentro del contenedor. Aquí se reutiliza la imagen publicada, para no volver a instalar las dependencias de Python.
FROM ghcr.io/harry0703/moneyprinterturbo:latest

# La versión de la CLI está fijada, para que el comportamiento no cambie al reconstruir la imagen; para actualizar basta con cambiar aquí el número de versión.
ARG CLAUDE_CODE_VERSION=2.1.260
ARG NODE_MAJOR=22

# La CLI claude se distribuye por npm y la imagen publicada no tiene Node.js, así que primero hay que instalar el repositorio de NodeSource.
RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg; \
    curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash -; \
    apt-get install -y --no-install-recommends nodejs; \
    npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"; \
    npm cache clean --force; \
    apt-get purge -y gnupg; \
    apt-get autoremove -y; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    claude --version
